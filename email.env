# Copy this file to ".env" (same folder as manage.py), fill it in, then restart the server.
# Without DJANGO_EMAIL_HOST, emails are only printed in the terminal that runs `runserver`.

# Gmail example. Use an "App password" (Google Account > Security > 2-Step Verification > App passwords),
# not your normal password.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_HOST_USER=immarkuuu@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=hewyyzvzmagbudst
DJANGO_DEFAULT_FROM_EMAIL=LibraryOS <youraddress@gmail.com>
